PORT=4001
DATABASE_URL=postgresql://postgres:sifre@localhost:5432/sosyal_medya
DATABASE_SSL=false
JWT_SECRET=gizli-anahtar-buraya-yazin

CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Dışarıdan erişilebilir URL (OAuth callback için)
APP_URL=http://localhost:4001

# ─── Facebook / Instagram (Meta) ─────────────────────────────────────────────
# developers.facebook.com → Uygulamam → Ayarlar → Temel
META_APP_ID=
META_APP_SECRET=
# Redirect URI: {APP_URL}/api/hesaplar/callback/facebook

# ─── Twitter / X ─────────────────────────────────────────────────────────────
# developer.twitter.com → Keys and tokens
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Redirect URI: {APP_URL}/api/hesaplar/callback/twitter

# ─── Pinterest ────────────────────────────────────────────────────────────────
# developers.pinterest.com
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Redirect URI: {APP_URL}/api/hesaplar/callback/pinterest

# ─── YouTube / Google ─────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI: {APP_URL}/api/hesaplar/callback/youtube
